{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // supabase/functions 는 Deno 에서 도는 코드입니다. Node 타입으로 검사하면
  // Deno 전역과 .ts 확장자 import 가 전부 오류로 잡힙니다.
  //
  // app/_print* 는 «세워 둔» 화면입니다. 밑줄로 시작하는 폴더는 Next 가
  // 라우트로 만들지 않으므로 사이트에서 사라졌지만, 파일은 그대로 남아
  // 있습니다. 그 안의 PageProps<"/print/…"> 는 이제 없는 주소를 가리키니
  // 검사에서 빼 둡니다. 다시 켤 때 폴더 이름의 밑줄만 떼면 됩니다 —
  // docs/print-hidden.md 참고.
  "exclude": [
    "node_modules",
    "supabase/functions",
    "app/_print",
    "app/_print-templates.json"
  ]
}
