# ============================================================
# Cardly — 환경변수
#
# 이 파일은 "무엇이 필요한지"만 적어 둔 견본입니다. 실제 값은
# .env.local (git 에 올라가지 않음) 과 GitHub Actions Secrets 에 넣습니다.
# 값이 비어 있으면 사이트는 «저장·발행 없이 만들어 보는 모드» 로 동작합니다 —
# 이력서·명함·미리보기는 그대로 되고, 로그인과 발행 단추만 잠깁니다.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# 대시보드 > Project Settings > API 에서 복사합니다.
# anon 키는 브라우저에 노출되는 것을 전제로 만들어진 공개 키입니다.
# 실제 보호는 이 키가 아니라 RLS 정책이 합니다(supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 빌드 때만 씁니다 — 발행된 청첩장·초대장의 슬러그를 읽어
# 카카오톡 미리보기(OG)용 HTML 을 미리 만듭니다.
# 절대 브라우저로 나가면 안 되므로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 카카오 ──────────────────────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키.
# 없으면 공유 단추가 «링크 복사 / 문자» 로만 나옵니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 토스페이먼츠 ────────────────────────────────────────────
# 클라이언트 키는 결제창을 띄우는 공개 키입니다.
# 시크릿 키는 서버(Supabase Edge Function)에만 두고, 결제 승인은
# 반드시 서버에서 합니다. 아래에 적지 마세요 — supabase secrets set 으로 넣습니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ── 사이트 주소 ─────────────────────────────────────────────
# 결제 성공 후 되돌아올 주소와 공유 링크를 만들 때 씁니다.
NEXT_PUBLIC_SITE_URL=https://cardly.kr

# ============================================================
# 아래는 Supabase Edge Function 쪽 비밀값입니다. 이 파일이 아니라
# `supabase secrets set KEY=값` 으로 넣습니다.
#
#   TOSS_SECRET_KEY          토스페이먼츠 시크릿 키 (test_sk_… / live_sk_…)
#   GITHUB_DISPATCH_TOKEN    발행 직후 사이트를 다시 빌드해
#                            카카오톡 미리보기를 만들기 위한 PAT
#                            (repo 범위, contents:write)
#   GITHUB_REPOSITORY        nbh0000/Cardly_Web
# ============================================================
